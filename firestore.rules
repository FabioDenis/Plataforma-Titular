rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Platform admins are assigned server-side only (users/{uid}.isAdmin or role).
    // Clients can never write these fields, so the profile is a trusted source.
    function isAdmin() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return isSignedIn() && exists(profilePath) && (
        get(profilePath).data.get('isAdmin', false) == true ||
        get(profilePath).data.get('role', '') in ['admin', 'superadmin']
      );
    }

    function isOrgMember(orgData) {
      return isSignedIn() && (
        orgData.get('ownerUid', '') == request.auth.uid ||
        request.auth.uid in orgData.get('members', [])
      );
    }

    function canAccessOrgId(orgId) {
      let orgPath = /databases/$(database)/documents/organizations/$(orgId);
      return exists(orgPath) && isOrgMember(get(orgPath).data);
    }

    // users/{userId}: created by the server bootstrap. Clients may only switch
    // their active organization to one they belong to.
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create, delete: if false;
      allow update: if isUser(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId', 'displayName', 'updatedAt'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId']) ||
          canAccessOrgId(request.resource.data.organizationId)
        );
    }

    // organizations/{orgId}: created and billed server-side. Members may only
    // edit presentation fields; plan, limits, usage, status and ownership are server-owned.
    match /organizations/{orgId} {
      // A missing document is only readable as the user's own default organization (no existence probing).
      allow get: if isSignedIn() && (
        (resource == null && orgId == 'org_' + request.auth.uid) ||
        (resource != null && (isOrgMember(resource.data) || isAdmin()))
      );
      allow list: if isOrgMember(resource.data) || isAdmin();
      allow create, delete: if false;
      // Members edit their newsroom's presentation; platform admins can prepare any newsroom for a client.
      allow update: if (isOrgMember(resource.data) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'logoUrl',
          'activeOfficialTemplateId',
          'activeOfficialTemplateName',
          'activeOfficialTemplateCustomization',
          'activeIdentityId',
          'branding',
          'updatedAt'
        ]);

      // Shared newsroom workspace: every member reads and edits the same identities and history.
      match /identities/{identityId} {
        allow read, write: if canAccessOrgId(orgId) || isAdmin();
      }

      match /history/{newsId} {
        allow read, write: if canAccessOrgId(orgId) || isAdmin();
      }

      match /privateMetaTokens/{tokenDoc} {
        allow read, write: if false;
      }

      match /socialConnections/{connId} {
        allow read: if canAccessOrgId(orgId) || isAdmin();
        allow write: if false;
      }

      match /publications/{pubId} {
        allow read: if canAccessOrgId(orgId) || isAdmin();
        allow write: if false;
      }

      match /generationLedger/{movementId} {
        allow read: if canAccessOrgId(orgId) || isAdmin();
        allow write: if false;
      }
    }

    match /billingUsers/{uid} {
      allow read: if isUser(uid);
      allow write: if false;

      match /ledger/{eventId} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    match /billingEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
